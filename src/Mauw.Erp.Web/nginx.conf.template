# Le variabili nginx ($uri, $host, ...) non vengono toccate da envsubst:
# solo le variabili d'ambiente definite (es. ${API_UPSTREAM}) sono sostituite.

# Mantiene lo schema/host originali quando davanti c'e' il reverse proxy HTTPS
map $http_x_forwarded_proto $forwarded_proto {
    default $scheme;
    https   https;
    http    http;
}

server {
    listen 80;
    server_name _;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml
               image/svg+xml font/ttf font/otf;

    client_max_body_size 20M;

    root /usr/share/nginx/html;

    # API, Swagger e callback OIDC (Entra ID) verso il container api interno
    location ~ ^/(api/|swagger|signin-oidc|signout-callback-oidc) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
    }

    # Asset con hash nel nome: cache lunga
    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: fallback su index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
