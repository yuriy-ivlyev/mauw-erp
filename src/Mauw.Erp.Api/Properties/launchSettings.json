{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5019",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ConnectionStrings__PostgreSQL": "Host=localhost;Database=mauw_erp;Username=postgres;Password=postgres;Port=5432"
      }
    },
    "Docker Compose": {
      "commandName": "DockerCompose",
      "serviceStartupProject": "src/Mauw.Erp.Api/Mauw.Erp.Api.csproj",
      "startAction": "None",
      "composeFiles": ["docker-compose.dev.yml"]
    }
  }
}