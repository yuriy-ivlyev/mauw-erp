<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mauw.Erp.Infrastructure\Mauw.Erp.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Build Angular web app and copy to wwwroot -->
  <Target Name="BuildWebApp" BeforeTargets="Build">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\web" />
    <ItemGroup>
      <WebFiles Include="$(MSBuildProjectDirectory)\web\dist\web\browser\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebFiles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" />
  </Target>

  <!-- Clean Angular build output -->
  <Target Name="CleanWebApp" BeforeTargets="Clean">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\web\dist" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

</Project>
