# Copia questo file in .env (non tracciato da Git) e valorizza le variabili
# per il deploy Docker Compose.

# Google Places API (New) - https://console.cloud.google.com/
# Lascia vuoto per usare solo il provider OSM/Photon (gratuito)
GOOGLEPLACES__APIKEY=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mauw_erp

# Microsoft Entra ID SSO (App Registration - Web platform)
# Portale: https://portal.azure.com → Entra ID → App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Reverse proxy HTTPS (docker compose) - opzionali
# HTTPS_PORT=5019
# CERT_PASSWORD=MauwDev2024!
