# Copia questo file in .env (non tracciato da Git) e valorizza le variabili
# per il deploy Docker Compose.

# Google Places API (New) - https://console.cloud.google.com/
# Lascia vuoto per usare solo il provider OSM/Photon (gratuito)
GOOGLEPLACES__APIKEY=

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mauw_erp

# Microsoft Entra ID SSO (App Registration - Web platform)
# Portale: https://portal.azure.com → Entra ID → App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# MinIO (storage immagini S3-compatibile): credenziali root e bucket
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# S3_BUCKET=mauw-erp-images

# Grafana Cloud OTLP (endpoint del tuo stack; il collector usa OTLP/HTTP)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=mauw-erp-develop
# Copia qui il valore dopo "Authorization=" nell'header Grafana (include "Basic ")
GRAFANA_CLOUD_AUTHORIZATION=

# Reverse proxy HTTPS (docker compose) - opzionali
# HTTPS_PORT=5019
# CERT_PASSWORD=MauwDev2024!
