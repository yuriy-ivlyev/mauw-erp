<Project>
  <!--
    Centralised package-version overrides.
    Pins transitive dependencies that carry known CVEs to their patched release.
  -->
  <ItemGroup>
    <!-- PDFsharp-MigraDoc pulls System.Security.Cryptography.Pkcs 8.0.1
         which has NU1902 (GHSA-2fmv-rv2c-59x7) and NU1903 (GHSA-846f-f764-76mx).
         Force resolution to the patched .NET 10 runtime version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
