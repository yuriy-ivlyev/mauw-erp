{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: build changed + up",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev-up.ps1", "-Target", "auto"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "docker: rebuild all + up",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev-up.ps1", "-Target", "all"],
      "problemMatcher": []
    },
    {
      "label": "docker: rebuild api + up",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev-up.ps1", "-Target", "api"],
      "problemMatcher": []
    },
    {
      "label": "docker: rebuild web + up",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev-up.ps1", "-Target", "web"],
      "problemMatcher": []
    },
    {
      "label": "docker: down",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/dev-up.ps1", "-Target", "down"],
      "problemMatcher": []
    },
    {
      "label": "docker: logs",
      "type": "shell",
      "command": "docker compose logs -f --tail 100 api web proxy",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
